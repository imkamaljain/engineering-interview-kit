---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
}


const { title } = Astro.props;
const pathname = Astro.url.pathname;
const topics = await getCollection('topics');
const slugify = (str) => str.toLowerCase().replace(/\s+/g, '-').replace(/\./g, '');

let sidebarMode = 'default';
let currentCategoryName = '';
let currentCategoryTopics = [];
let currentTopicId = '';

if (pathname.startsWith('/topics/')) {
    const parts = pathname.split('/').filter(Boolean);
    const knownCategories = ['javascript', 'typescript', 'go', 'nodejs', 'sql', 'system-design', 'dsa'];
    
    if (parts.length === 2 && knownCategories.includes(parts[1])) {
        // It's a category page (e.g. /topics/javascript)
        const slug = parts[1];
        sidebarMode = 'category';
        currentCategoryTopics = topics.filter(t => slugify(t.data.category) === slug);
        currentCategoryTopics.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
        currentCategoryName = currentCategoryTopics.length > 0 ? currentCategoryTopics[0].data.category : slug;
    } else if (parts.length >= 2) {
        // It's a topic page (e.g. /topics/javascript/event-loop)
        const topicSlug = parts.slice(1).join('/'); 
        const currentTopic = topics.find(t => t.id === topicSlug || t.id === parts[1]);
        
        if (currentTopic) {
            sidebarMode = 'category';
            currentTopicId = currentTopic.id;
            const catSlug = slugify(currentTopic.data.category);
            currentCategoryTopics = topics.filter(t => slugify(t.data.category) === catSlug);
            currentCategoryTopics.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
            currentCategoryName = currentTopic.data.category;
        }
    }
}

---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- KaTeX CSS for math rendering -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
		<!-- Mermaid setup -->
		<script type="module">
			import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
			mermaid.initialize({ startOnLoad: false, theme: 'dark' });

			const containers = document.querySelectorAll('.mermaid-container');
			if (containers.length > 0) {
				for (let i = 0; i < containers.length; i++) {
					const div = containers[i];
					const rawText = decodeURIComponent(div.getAttribute('data-mermaid-encoded'));
					try {
						const { svg } = await mermaid.render('mermaid-svg-' + i, rawText);
						div.innerHTML = svg;
						div.style.cursor = 'zoom-in';
						div.classList.add('hover:opacity-80', 'transition-opacity', 'duration-200');
						div.addEventListener('click', () => {
							window.dispatchEvent(new CustomEvent('open-diagram-modal', { detail: svg }));
						});
					} catch(e) {
						console.error('Mermaid render error:', e);
						div.innerHTML = `<div class="text-red-500 text-xs font-mono block p-4 bg-red-900/20 rounded border border-red-900/50 overflow-x-auto whitespace-pre-wrap"><b>Mermaid Error:</b> ${e.message || e}<br/><br/><b>Raw Text:</b><br/>${rawText.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</div>`;
					}
				}
			}
		</script>
	</head>
	<body class="bg-gray-950 text-gray-200 antialiased selection:bg-blue-500/30">
		<div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-blue-500 z-[100] transition-all duration-150 ease-out shadow-[0_0_10px_rgba(59,130,246,0.8)]" style="width: 0%"></div>
		<div class="flex min-h-screen">
			<!-- Sidebar -->
			{sidebarMode === 'category' && (
			<aside id="app-sidebar" class="relative w-64 border-r border-gray-800/60 hidden md:flex flex-col h-screen sticky top-0 bg-[#0d1117] transition-all duration-300 ease-in-out shrink-0">
				<div id="sidebar-content-wrapper" class="w-64 h-full overflow-hidden transition-all duration-300 ease-in-out">
					<div class="w-64 flex flex-col h-full">
						
						<!-- Fixed Header -->
						<div class="p-5 shrink-0 border-b border-gray-800/40 bg-[#0d1117] z-10">
							<a href="/" class="flex items-center gap-3 group">
								<img src="/logo.svg" alt="Logo" class="w-10 h-10 drop-shadow-md group-hover:scale-105 transition-transform duration-300" />
								<span class="text-[17px] font-bold tracking-tight text-gray-100 group-hover:text-white leading-tight transition-colors">
									Engineering<br/>Interview Kit
								</span>
							</a>
						</div>
					
						<!-- Scrollable Content -->
						<div class="flex-1 overflow-y-auto p-5 pt-6 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
							<nav class="text-sm pb-8 -mx-3">
								<div class="px-3">
									<h3 class="font-bold text-gray-100 mb-6 text-[13px] flex items-center gap-2 tracking-wide uppercase">
										{currentCategoryName} Topics
									</h3>
									
									{Object.entries(
										currentCategoryTopics.reduce((acc, topic) => {
											const sub = topic.data.subcategory || 'Other Topics';
											if (!acc[sub]) acc[sub] = [];
											acc[sub].push(topic);
											return acc;
										}, {})
									).map(([subcat, subTopics]) => (
										<div class="mb-6 last:mb-0">
											<h4 class="font-semibold text-gray-300 mb-2 text-[12px] flex items-center gap-2.5 group cursor-default">
												<span class="w-1.5 h-1.5 rounded-full bg-gray-700 group-hover:bg-blue-500/50 transition-colors shrink-0"></span>
												{subcat}
											</h4>
											<ul class="relative space-y-0.5 before:absolute before:inset-y-1 before:left-[1.5px] before:w-px before:bg-gray-800/80 ml-0.5">
												{subTopics.map((t: any) => (
													<li class="relative">
														{currentTopicId === t.id && (
															<div class="absolute left-[1.5px] top-1/2 -translate-y-1/2 w-[1.5px] h-full bg-blue-500 z-10 shadow-[0_0_8px_rgba(59,130,246,0.6)] scale-y-[0.6] rounded-full"></div>
														)}
														<a 
															href={`/topics/${t.id}`} 
															class={`group flex items-center w-full pl-6 pr-3 py-1.5 text-[13px] rounded-r-lg transition-all duration-300 ${currentTopicId === t.id ? 'text-blue-400 font-medium active-sidebar-link bg-gradient-to-r from-blue-500/10 to-transparent' : 'text-gray-400 hover:text-gray-200 hover:bg-gray-800/30'}`}
															aria-current={currentTopicId === t.id ? "page" : undefined}
														>
															<span class={`transition-transform duration-200 ${currentTopicId === t.id ? '' : 'group-hover:translate-x-1'}`}>{t.data.title}</span>
														</a>
													</li>
												))}
											</ul>
										</div>
									))}
								</div>
							</nav>
						</div>
					</div>
				</div>
				<!-- Sidebar Toggle Button (Top Right Edge) -->
				<button id="sidebar-toggle" class="absolute bottom-10 -right-3.5 z-50 bg-gray-900 border border-gray-700 text-gray-400 p-1.5 rounded-full shadow-lg hover:bg-gray-800 hover:text-white transition-all hidden md:flex items-center justify-center cursor-pointer" aria-label="Toggle Sidebar">
					<svg id="toggle-icon-open" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
					<svg id="toggle-icon-close" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path></svg>
				</button>
			</aside>
			)}
			<script is:inline>
				(function() {
					const sidebar = document.getElementById('app-sidebar');
					const contentWrapper = document.getElementById('sidebar-content-wrapper');
					const toggleBtn = document.getElementById('sidebar-toggle');
					const iconOpen = document.getElementById('toggle-icon-open');
					const iconClose = document.getElementById('toggle-icon-close');
					
					if (sidebar && toggleBtn && contentWrapper) {
						let isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
						
						const applyState = (instant = false) => {
							if (instant) {
								sidebar.classList.remove('transition-all', 'duration-300');
								contentWrapper.classList.remove('transition-all', 'duration-300', 'ease-in-out');
								toggleBtn.classList.remove('transition-all');
							}

							if (isCollapsed) {
								sidebar.classList.remove('w-64', 'border-r');
								sidebar.classList.add('w-0', 'border-transparent');
								contentWrapper.classList.remove('w-64');
								contentWrapper.classList.add('w-0');
								
								toggleBtn.classList.remove('-right-3.5');
								toggleBtn.classList.add('-right-10'); 

								iconClose.classList.add('hidden');
								iconOpen.classList.remove('hidden');
							} else {
								sidebar.classList.add('w-64', 'border-r');
								sidebar.classList.remove('w-0', 'border-transparent');
								contentWrapper.classList.add('w-64');
								contentWrapper.classList.remove('w-0');
								
								toggleBtn.classList.add('-right-3.5');
								toggleBtn.classList.remove('-right-10');

								iconClose.classList.remove('hidden');
								iconOpen.classList.add('hidden');
							}

							if (instant) {
								// Force reflow
								void sidebar.offsetWidth;
								sidebar.classList.add('transition-all', 'duration-300');
								contentWrapper.classList.add('transition-all', 'duration-300', 'ease-in-out');
								toggleBtn.classList.add('transition-all');
							}
						};
						
						// Initial load must be instant to prevent animation FOUC
						applyState(true);
						
						toggleBtn.addEventListener('click', () => {
							isCollapsed = !isCollapsed;
							localStorage.setItem('sidebar-collapsed', isCollapsed);
							applyState(false); // Animate on user click
						});
					}

					// Scroll active sidebar link into view
					const activeSidebarLink = document.querySelector('.active-sidebar-link');
					if (activeSidebarLink) {
						// Use block: 'center' to ensure it's visible in the middle of the sidebar viewport
						activeSidebarLink.scrollIntoView({ block: 'center' });
					}
				})();
			</script>


			<!-- Main content -->
			<main class="flex-1 max-w-4xl px-5 py-5 mx-auto w-full">
				<slot />
			</main>
		</div>

		<!-- Diagram Zoom Modal -->
		<div id="diagram-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 sm:p-8 opacity-0 transition-opacity duration-300">
			<div class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity" id="diagram-modal-backdrop"></div>
			<div class="relative bg-gray-900 border border-gray-700/80 rounded-xl shadow-2xl overflow-hidden w-full max-w-6xl max-h-[90vh] flex flex-col scale-95 transition-transform duration-300" id="diagram-modal-content">
				<div class="overflow-auto p-4 sm:p-8 bg-gray-950 flex-1 flex justify-center items-center" id="diagram-modal-body">
					<!-- SVG injected here -->
				</div>
			</div>
		</div>

		<script>
			// Diagram Modal Logic
			(function() {
				const modal = document.getElementById('diagram-modal');
				const backdrop = document.getElementById('diagram-modal-backdrop');
				const content = document.getElementById('diagram-modal-content');
				const body = document.getElementById('diagram-modal-body');
				const closeBtn = document.getElementById('diagram-modal-close');

				let isOpen = false;

				function openModal(svgContent) {
					if (!modal) return;
					isOpen = true;
					body.innerHTML = svgContent;
					
					// Setup SVGs to fit perfectly in the modal without cropping
					const svgElement = body.querySelector('svg');
					if (svgElement) {
						svgElement.removeAttribute('width');
						svgElement.removeAttribute('height');
						svgElement.style.width = '100%';
						svgElement.style.height = '100%';
						svgElement.style.maxHeight = '70vh'; // Constrain height to ensure it fits the viewport
						svgElement.style.objectFit = 'contain';
					}

					modal.classList.remove('hidden');
					// Force reflow
					void modal.offsetWidth;
					modal.classList.remove('opacity-0');
					content.classList.remove('scale-95');
					content.classList.add('scale-100');
					document.body.style.overflow = 'hidden';
				}

				function closeModal() {
					if (!modal || !isOpen) return;
					isOpen = false;
					modal.classList.add('opacity-0');
					content.classList.remove('scale-100');
					content.classList.add('scale-95');
					document.body.style.overflow = '';
					
					setTimeout(() => {
						if (!isOpen) {
							modal.classList.add('hidden');
							body.innerHTML = '';
						}
					}, 300);
				}

				window.addEventListener('open-diagram-modal', (e) => openModal(e.detail));
				closeBtn?.addEventListener('click', closeModal);
				backdrop?.addEventListener('click', closeModal);
				
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && isOpen) closeModal();
				});
			})();

			// Keyboard shortcut for search
			document.addEventListener('keydown', (e) => {
				if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
					e.preventDefault();
					const searchInput = document.getElementById('search-input') || document.getElementById('global-search-input');
					searchInput?.focus();
				}
			});

			// Reading Progress Bar Logic
			window.addEventListener('scroll', () => {
				const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				// Only show progress if the page is scrollable
				const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
				const progressBar = document.getElementById('reading-progress');
				if (progressBar) {
					progressBar.style.width = scrolled + '%';
				}
			});

			// Copy Code Button Logic
			(function() {
				const codeBlocks = document.querySelectorAll('pre');
				codeBlocks.forEach((pre) => {
					if (pre.classList.contains('mermaid')) return;
					
					const wrapper = document.createElement('div');
					wrapper.className = 'relative group';
					// Maintain prose margins by transferring them to the wrapper
					wrapper.style.marginTop = window.getComputedStyle(pre).marginTop;
					wrapper.style.marginBottom = window.getComputedStyle(pre).marginBottom;
					pre.style.marginTop = '0';
					pre.style.marginBottom = '0';
					
					pre.parentNode.insertBefore(wrapper, pre);
					wrapper.appendChild(pre);
					
					const copyBtn = document.createElement('button');
					copyBtn.className = 'absolute top-3 right-3 p-1.5 bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-white rounded-md border border-gray-700 opacity-0 group-hover:opacity-100 transition-all duration-200 z-10 cursor-pointer';
					copyBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`;
					copyBtn.setAttribute('aria-label', 'Copy code');
					
					wrapper.appendChild(copyBtn);
					
					copyBtn.addEventListener('click', async () => {
						const code = pre.querySelector('code')?.innerText || pre.innerText;
						try {
							await navigator.clipboard.writeText(code);
							copyBtn.innerHTML = `<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
							
							setTimeout(() => {
								copyBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`;
							}, 2000);
						} catch (err) {
							console.error('Failed to copy: ', err);
						}
					});
				});
			})();
		</script>
	</body>
</html>
