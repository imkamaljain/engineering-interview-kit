---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
}


const { title } = Astro.props;
const pathname = Astro.url.pathname;
const topics = await getCollection('topics');
const slugify = (str) => str.toLowerCase().replace(/\s+/g, '-').replace(/\./g, '');

let sidebarMode = 'default';
let currentCategoryName = '';
let currentCategoryTopics = [];
let currentTopicId = '';

if (pathname.startsWith('/topics/')) {
    const parts = pathname.split('/').filter(Boolean);
    const knownCategories = ['javascript', 'typescript', 'go', 'nodejs', 'sql', 'system-design', 'dsa'];
    
    if (parts.length === 2 && knownCategories.includes(parts[1])) {
        // It's a category page (e.g. /topics/javascript)
        const slug = parts[1];
        sidebarMode = 'category';
        currentCategoryTopics = topics.filter(t => slugify(t.data.category) === slug);
        currentCategoryTopics.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
        currentCategoryName = currentCategoryTopics.length > 0 ? currentCategoryTopics[0].data.category : slug;
    } else if (parts.length >= 2) {
        // It's a topic page (e.g. /topics/javascript/event-loop)
        const topicSlug = parts.slice(1).join('/'); 
        const currentTopic = topics.find(t => t.id === topicSlug || t.id === parts[1]);
        
        if (currentTopic) {
            sidebarMode = 'category';
            currentTopicId = currentTopic.id;
            const catSlug = slugify(currentTopic.data.category);
            currentCategoryTopics = topics.filter(t => slugify(t.data.category) === catSlug);
            currentCategoryTopics.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
            currentCategoryName = currentTopic.data.category;
        }
    }
}

---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Mermaid setup -->
		<script type="module">
			import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
			mermaid.initialize({ startOnLoad: false, theme: 'dark' });

			const containers = document.querySelectorAll('.mermaid-container');
			if (containers.length > 0) {
				for (let i = 0; i < containers.length; i++) {
					const div = containers[i];
					const rawText = decodeURIComponent(div.getAttribute('data-mermaid-encoded'));
					try {
						const { svg } = await mermaid.render('mermaid-svg-' + i, rawText);
						div.innerHTML = svg;
						div.style.cursor = 'zoom-in';
						div.classList.add('hover:opacity-80', 'transition-opacity', 'duration-200');
						div.addEventListener('click', () => {
							window.dispatchEvent(new CustomEvent('open-diagram-modal', { detail: svg }));
						});
					} catch(e) {
						console.error('Mermaid render error:', e);
						div.innerHTML = `<div class="text-red-500 text-xs font-mono block p-4 bg-red-900/20 rounded border border-red-900/50 overflow-x-auto whitespace-pre-wrap"><b>Mermaid Error:</b> ${e.message || e}<br/><br/><b>Raw Text:</b><br/>${rawText.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</div>`;
					}
				}
			}
		</script>
	</head>
	<body class="bg-gray-950 text-gray-200 antialiased selection:bg-blue-500/30">
		<div class="flex min-h-screen">
			<!-- Sidebar -->
			{sidebarMode === 'category' && (
			<aside id="app-sidebar" class="relative w-64 border-r border-gray-800/60 hidden md:flex flex-col h-screen sticky top-0 bg-[#0d1117] transition-all duration-300 ease-in-out shrink-0">
				<div id="sidebar-content-wrapper" class="w-64 h-full overflow-hidden transition-all duration-300 ease-in-out">
					<div class="w-64 flex flex-col h-full overflow-y-auto">
				<div class="p-5">
					<a href="/" class="text-lg font-bold tracking-tight text-gray-100 hover:text-white transition-colors block mb-6">
						Engineering<br/>Interview Kit
					</a>
					
							<nav class="space-y-6 text-sm overflow-y-auto pb-8">
								<a href="/" class="text-gray-400 hover:text-white flex items-center mb-6 transition-colors">
									<span class="mr-2">←</span> All Categories
								</a>
								<div>
									<h3 class="font-semibold text-blue-400 mb-4 uppercase tracking-wider text-xs">{currentCategoryName} Topics</h3>
									
									{Object.entries(
										currentCategoryTopics.reduce((acc, topic) => {
											const sub = topic.data.subcategory || 'Other Topics';
											if (!acc[sub]) acc[sub] = [];
											acc[sub].push(topic);
											return acc;
										}, {})
									).map(([subcat, subTopics]) => (
										<div class="mb-6 last:mb-0">
											<h4 class="font-semibold text-gray-500 mb-3 uppercase tracking-wider text-[10px]">{subcat}</h4>
											<ul class="space-y-2.5">
												{subTopics.map((t: any) => (
													<li>
														<a 
															href={`/topics/${t.id}`} 
															class={`block transition-colors ${currentTopicId === t.id ? 'text-blue-400 font-medium active-sidebar-link' : 'text-gray-400 hover:text-white'}`}
															aria-current={currentTopicId === t.id ? "page" : undefined}
														>
															{t.data.title}
														</a>
													</li>
												))}
											</ul>
										</div>
									))}
								</div>
							</nav>
										</div>
					</div>
				</div>
				<!-- Sidebar Toggle Button (Top Right Edge) -->
				<button id="sidebar-toggle" class="absolute top-8 -right-3.5 z-50 bg-gray-900 border border-gray-700 text-gray-400 p-1.5 rounded-full shadow-lg hover:bg-gray-800 hover:text-white transition-all hidden md:flex items-center justify-center cursor-pointer" aria-label="Toggle Sidebar">
					<svg id="toggle-icon-open" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
					<svg id="toggle-icon-close" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path></svg>
				</button>
			</aside>
			)}
			<script is:inline>
				(function() {
					const sidebar = document.getElementById('app-sidebar');
					const contentWrapper = document.getElementById('sidebar-content-wrapper');
					const toggleBtn = document.getElementById('sidebar-toggle');
					const iconOpen = document.getElementById('toggle-icon-open');
					const iconClose = document.getElementById('toggle-icon-close');
					
					if (sidebar && toggleBtn && contentWrapper) {
						let isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
						
						const applyState = (instant = false) => {
							if (instant) {
								sidebar.classList.remove('transition-all', 'duration-300');
								contentWrapper.classList.remove('transition-all', 'duration-300', 'ease-in-out');
								toggleBtn.classList.remove('transition-all');
							}

							if (isCollapsed) {
								sidebar.classList.remove('w-64', 'border-r');
								sidebar.classList.add('w-0', 'border-transparent');
								contentWrapper.classList.remove('w-64');
								contentWrapper.classList.add('w-0');
								
								toggleBtn.classList.remove('-right-3.5');
								toggleBtn.classList.add('-right-10'); 

								iconClose.classList.add('hidden');
								iconOpen.classList.remove('hidden');
							} else {
								sidebar.classList.add('w-64', 'border-r');
								sidebar.classList.remove('w-0', 'border-transparent');
								contentWrapper.classList.add('w-64');
								contentWrapper.classList.remove('w-0');
								
								toggleBtn.classList.add('-right-3.5');
								toggleBtn.classList.remove('-right-10');

								iconClose.classList.remove('hidden');
								iconOpen.classList.add('hidden');
							}

							if (instant) {
								// Force reflow
								void sidebar.offsetWidth;
								sidebar.classList.add('transition-all', 'duration-300');
								contentWrapper.classList.add('transition-all', 'duration-300', 'ease-in-out');
								toggleBtn.classList.add('transition-all');
							}
						};
						
						// Initial load must be instant to prevent animation FOUC
						applyState(true);
						
						toggleBtn.addEventListener('click', () => {
							isCollapsed = !isCollapsed;
							localStorage.setItem('sidebar-collapsed', isCollapsed);
							applyState(false); // Animate on user click
						});
					}

					// Scroll active sidebar link into view
					const activeSidebarLink = document.querySelector('.active-sidebar-link');
					if (activeSidebarLink) {
						// Use block: 'center' to ensure it's visible in the middle of the sidebar viewport
						activeSidebarLink.scrollIntoView({ block: 'center' });
					}
				})();
			</script>


			<!-- Main content -->
			<main class="flex-1 max-w-4xl px-6 py-10 lg:px-12 mx-auto w-full">
				<slot />
			</main>
		</div>

		<!-- Diagram Zoom Modal -->
		<div id="diagram-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 sm:p-8 opacity-0 transition-opacity duration-300">
			<div class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity" id="diagram-modal-backdrop"></div>
			<div class="relative bg-gray-900 border border-gray-700/80 rounded-xl shadow-2xl overflow-hidden w-full max-w-6xl max-h-[90vh] flex flex-col scale-95 transition-transform duration-300" id="diagram-modal-content">
				<div class="overflow-auto p-4 sm:p-8 bg-gray-950 flex-1 flex justify-center items-center" id="diagram-modal-body">
					<!-- SVG injected here -->
				</div>
			</div>
		</div>

		<script>
			// Diagram Modal Logic
			(function() {
				const modal = document.getElementById('diagram-modal');
				const backdrop = document.getElementById('diagram-modal-backdrop');
				const content = document.getElementById('diagram-modal-content');
				const body = document.getElementById('diagram-modal-body');
				const closeBtn = document.getElementById('diagram-modal-close');

				let isOpen = false;

				function openModal(svgContent) {
					if (!modal) return;
					isOpen = true;
					body.innerHTML = svgContent;
					
					// Setup SVGs to fit perfectly in the modal without cropping
					const svgElement = body.querySelector('svg');
					if (svgElement) {
						svgElement.removeAttribute('width');
						svgElement.removeAttribute('height');
						svgElement.style.width = '100%';
						svgElement.style.height = '100%';
						svgElement.style.maxHeight = '70vh'; // Constrain height to ensure it fits the viewport
						svgElement.style.objectFit = 'contain';
					}

					modal.classList.remove('hidden');
					// Force reflow
					void modal.offsetWidth;
					modal.classList.remove('opacity-0');
					content.classList.remove('scale-95');
					content.classList.add('scale-100');
					document.body.style.overflow = 'hidden';
				}

				function closeModal() {
					if (!modal || !isOpen) return;
					isOpen = false;
					modal.classList.add('opacity-0');
					content.classList.remove('scale-100');
					content.classList.add('scale-95');
					document.body.style.overflow = '';
					
					setTimeout(() => {
						if (!isOpen) {
							modal.classList.add('hidden');
							body.innerHTML = '';
						}
					}, 300);
				}

				window.addEventListener('open-diagram-modal', (e) => openModal(e.detail));
				closeBtn?.addEventListener('click', closeModal);
				backdrop?.addEventListener('click', closeModal);
				
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && isOpen) closeModal();
				});
			})();

			// Keyboard shortcut for search
			document.addEventListener('keydown', (e) => {
				if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
					e.preventDefault();
					const searchInput = document.getElementById('search-input') || document.getElementById('global-search-input');
					searchInput?.focus();
				}
			});
		</script>
	</body>
</html>
