---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  
  return topics.map((topic) => {
    // Find all topics in the same category to determine prev/next
    const categoryTopics = topics.filter(t => t.data.category === topic.data.category);
    categoryTopics.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
    const currentIndex = categoryTopics.findIndex(t => t.id === topic.id);
    
    const prevTopic = currentIndex > 0 ? categoryTopics[currentIndex - 1] : null;
    const nextTopic = currentIndex < categoryTopics.length - 1 ? categoryTopics[currentIndex + 1] : null;

    return {
      params: { slug: topic.id },
      props: { topic, prevTopic, nextTopic },
    };
  });
}

const { topic, prevTopic, nextTopic } = Astro.props;
const { Content } = await render(topic);

const getImportanceColor = (importance) => {
  switch(importance) {
    case 'HIGH': return 'bg-rose-500/10 text-rose-400 border-rose-500/20';
    case 'MEDIUM': return 'bg-blue-500/10 text-blue-400 border-blue-500/20';
    case 'LOW': return 'bg-gray-500/10 text-gray-400 border-gray-500/20';
    default: return 'bg-gray-500/10 text-gray-400 border-gray-500/20';
  }
};

const slugify = (str) => str.toLowerCase().replace(/\s+/g, '-').replace(/\./g, '');
---

<Layout title={`${topic.data.title} | Engineering Interview Kit`}>
  <article class="max-w-none">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-5 w-max max-w-full overflow-hidden">
      <ol class="flex items-center space-x-1.5 sm:space-x-2 bg-gray-900/60 border border-gray-800/80 px-3 sm:px-4 py-2 rounded-full shadow-inner backdrop-blur-sm text-[11px] sm:text-xs font-medium text-gray-400 overflow-x-auto whitespace-nowrap [&::-webkit-scrollbar]:hidden">
        <li class="flex items-center">
          <a href="/" class="flex items-center hover:text-white transition-colors">
            <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
            Home
          </a>
        </li>
        <li class="flex items-center">
          <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </li>
        <li class="flex items-center">
          <a href={`/topics/${slugify(topic.data.category)}`} class="hover:text-white transition-colors capitalize">
            {topic.data.category}
          </a>
        </li>
        <li class="flex items-center">
          <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </li>
        <li class="flex items-center" aria-current="page">
          <span class="text-blue-400 bg-blue-500/10 px-2.5 py-0.5 rounded-full border border-blue-500/20 truncate max-w-[150px] sm:max-w-[300px]">{topic.data.title}</span>
        </li>
      </ol>
    </nav>


    <header class="mb-8">
      <h1 class="text-4xl font-extrabold text-white mb-5 tracking-tight">{topic.data.title}</h1>
      
      <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
        <div class={`px-3 py-1.5 rounded-full border flex items-center ${getImportanceColor(topic.data.importance)}`}>
          <span class="mr-1.5">⭐</span> Interview Importance: {topic.data.importance}
        </div>
        <div class="px-3 py-1.5 rounded-full border bg-emerald-500/10 text-emerald-400 border-emerald-500/20 flex items-center">
          <span class="mr-1.5">⏱️</span> Revision Time: {topic.data.revisionTime} min
        </div>
      </div>
    </header>

    <!-- MDX Content -->
    <div class="prose prose-invert prose-blue max-w-none mb-16">
      <Content />
    </div>

    <!-- Bottom Navigation -->
    <div class="flex justify-between items-center pt-8 border-t border-gray-800">
      {prevTopic ? (
        <a href={`/topics/${prevTopic.id}`} class="group flex items-center text-gray-400 hover:text-white transition-colors">
          <div class="flex flex-col">
            <span class="text-xs uppercase tracking-wider mb-1">Previous Topic</span>
            <span class="font-medium flex items-center"><span class="mr-2 group-hover:-translate-x-1 transition-transform">←</span> {prevTopic.data.title}</span>
          </div>
        </a>
      ) : <div></div>}
      
      {nextTopic ? (
        <a href={`/topics/${nextTopic.id}`} class="group flex items-center text-right text-gray-400 hover:text-white transition-colors text-right">
          <div class="flex flex-col items-end">
            <span class="text-xs uppercase tracking-wider mb-1">Next Topic</span>
            <span class="font-medium flex items-center">{nextTopic.data.title} <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span></span>
          </div>
        </a>
      ) : <div></div>}
    </div>
  </article>

  <!-- Script to enhance code blocks with copy button -->
  <script>
    document.addEventListener('astro:page-load', () => {
      const preBlocks = document.querySelectorAll('pre');
      preBlocks.forEach((pre) => {
        if(pre.querySelector('.copy-btn')) return;
        
        const btn = document.createElement('button');
        btn.className = 'copy-btn absolute top-3 right-3 bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs px-2 py-1 rounded transition-colors border border-gray-700';
        btn.innerText = 'Copy';
        
        pre.style.position = 'relative';
        pre.appendChild(btn);

        btn.addEventListener('click', () => {
          const code = pre.querySelector('code');
          if(code) {
            navigator.clipboard.writeText(code.innerText);
            btn.innerText = 'Copied!';
            setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
          }
        });
      });
    });
  </script>
</Layout>
