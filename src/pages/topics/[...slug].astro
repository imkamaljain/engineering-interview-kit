---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getCategoryIcon } from "../../utils/icons";
import { SUBCATEGORY_ORDER } from "../../config/subcategories";

export async function getStaticPaths() {
  const topics = await getCollection("topics");

  return topics.map((topic) => {
    // Find all topics in the same category to determine prev/next
    const categoryTopics = topics.filter(
      (t) => t.data.category === topic.data.category,
    );

    // Normalize category slug for lookup
    const slugify = (str: string) =>
      str.toLowerCase().replace(/\s+/g, "-").replace(/\./g, "");
    const catSlug = slugify(topic.data.category);
    const orderArr = SUBCATEGORY_ORDER[catSlug] || [];

    categoryTopics.sort((a, b) => {
      const subA = a.data.subcategory || "Other Topics";
      const subB = b.data.subcategory || "Other Topics";
      const aIdx = orderArr.indexOf(subA);
      const bIdx = orderArr.indexOf(subB);
      const effectiveAIdx = aIdx === -1 ? 999 : aIdx;
      const effectiveBIdx = bIdx === -1 ? 999 : bIdx;

      if (effectiveAIdx !== effectiveBIdx) {
        return effectiveAIdx - effectiveBIdx;
      }
      return (a.data.order || 99) - (b.data.order || 99);
    });

    const currentIndex = categoryTopics.findIndex((t) => t.id === topic.id);

    const prevTopic =
      currentIndex > 0 ? categoryTopics[currentIndex - 1] : null;
    const nextTopic =
      currentIndex < categoryTopics.length - 1
        ? categoryTopics[currentIndex + 1]
        : null;

    return {
      params: { slug: topic.id },
      props: { topic, prevTopic, nextTopic },
    };
  });
}

const { topic, prevTopic, nextTopic } = Astro.props;
const { Content } = await render(topic);

const getImportanceColor = (importance: any) => {
  switch (importance) {
    case "HIGH":
      return "bg-rose-500/10 text-rose-400 border-rose-500/20";
    case "MEDIUM":
      return "bg-blue-500/10 text-blue-400 border-blue-500/20";
    case "LOW":
      return "bg-gray-500/10 text-gray-400 border-gray-500/20";
    default:
      return "bg-gray-500/10 text-gray-400 border-gray-500/20";
  }
};

const getDifficultyColor = (difficulty: any) => {
  switch (difficulty?.toUpperCase()) {
    case "HARD":
      return "bg-rose-500/10 text-rose-400 border-rose-500/20";
    case "MEDIUM":
      return "bg-amber-500/10 text-amber-400 border-amber-500/20";
    case "EASY":
      return "bg-emerald-500/10 text-emerald-400 border-emerald-500/20";
    default:
      return "bg-gray-500/10 text-gray-400 border-gray-500/20";
  }
};

const slugify = (str: string) =>
  str.toLowerCase().replace(/\s+/g, "-").replace(/\./g, "");
const catSlug = slugify(topic.data.category);
const catIcon = getCategoryIcon(catSlug);
---

<Layout
  title={`${topic.data.title} | Engineering Interview Kit`}
  description={topic.data.description}
>
  <article class="max-w-none">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-5 md:hidden">
      <a
        href={`/topics/${catSlug}`}
        class="inline-flex items-center text-[13px] font-medium text-gray-400 hover:text-gray-200 bg-gray-900/50 hover:bg-gray-800/80 border border-gray-800/60 hover:border-gray-700 px-3 py-1.5 rounded-full transition-all group shadow-sm backdrop-blur-sm"
      >
        <svg
          class="w-4 h-4 mr-1.5 group-hover:-translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to {topic.data.category} topics
      </a>
    </nav>

    <header class="mb-8">
      <h1 class="text-4xl font-extrabold text-white mb-5 tracking-tight">
        {topic.data.title}
      </h1>

      {
        (topic.data.importance ||
          topic.data.difficulty ||
          topic.data.revisionTime) && (
          <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
            {topic.data.importance && (
              <div
                class={`px-3 py-1.5 rounded-full border flex items-center ${getImportanceColor(topic.data.importance)}`}
              >
                <span class="mr-1.5">⭐</span> Interview Importance:{" "}
                {topic.data.importance}
              </div>
            )}
            {topic.data.difficulty && (
              <div
                class={`px-3 py-1.5 rounded-full border flex items-center ${getDifficultyColor(topic.data.difficulty)}`}
              >
                <span class="mr-1.5">🎯</span> Difficulty:{" "}
                {topic.data.difficulty.toUpperCase()}
              </div>
            )}
            {topic.data.revisionTime && (
              <div class="px-3 py-1.5 rounded-full border bg-emerald-500/10 text-emerald-400 border-emerald-500/20 flex items-center">
                <span class="mr-1.5">⏱️</span> Revision Time:{" "}
                {topic.data.revisionTime} min
              </div>
            )}
          </div>
        )
      }
    </header>

    <!-- MDX Content -->
    <div class="prose prose-invert prose-blue max-w-none mb-16">
      <Content />
    </div>

    <!-- Bottom Navigation -->
    <div
      class="flex justify-between items-center pt-8 border-t border-gray-800"
    >
      {
        prevTopic ? (
          <a
            href={`/topics/${prevTopic.id}`}
            class="group flex items-center text-gray-400 hover:text-white transition-colors"
          >
            <div class="flex flex-col">
              <span class="text-xs uppercase tracking-wider mb-1">
                Previous Topic
              </span>
              <span class="font-medium flex items-center">
                <span class="mr-2 group-hover:-translate-x-1 transition-transform">
                  ←
                </span>{" "}
                {prevTopic.data.title}
              </span>
            </div>
          </a>
        ) : (
          <div />
        )
      }

      {
        nextTopic ? (
          <a
            href={`/topics/${nextTopic.id}`}
            class="group flex items-center text-right text-gray-400 hover:text-white transition-colors text-right"
          >
            <div class="flex flex-col items-end">
              <span class="text-xs uppercase tracking-wider mb-1">
                Next Topic
              </span>
              <span class="font-medium flex items-center">
                {nextTopic.data.title}{" "}
                <span class="ml-2 group-hover:translate-x-1 transition-transform">
                  →
                </span>
              </span>
            </div>
          </a>
        ) : (
          <div />
        )
      }
    </div>
  </article>

  <!-- Script to enhance code blocks with copy button -->
  <script>
    document.addEventListener("astro:page-load", () => {
      const preBlocks = document.querySelectorAll("pre");
      preBlocks.forEach((pre) => {
        if (pre.querySelector(".copy-btn")) return;

        const btn = document.createElement("button");
        btn.className =
          "copy-btn absolute top-3 right-3 bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs px-2 py-1 rounded transition-colors border border-gray-700";
        btn.innerText = "Copy";

        pre.style.position = "relative";
        pre.appendChild(btn);

        btn.addEventListener("click", () => {
          const code = pre.querySelector("code");
          if (code) {
            navigator.clipboard.writeText(code.innerText);
            btn.innerText = "Copied!";
            setTimeout(() => {
              btn.innerText = "Copy";
            }, 2000);
          }
        });
      });
    });
  </script>
</Layout>
