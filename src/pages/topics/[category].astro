---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  
  // Helper to normalize category names to URL-friendly slugs
  const slugify = (str) => str.toLowerCase().replace(/\s+/g, '-').replace(/\./g, '');
  
  // Get unique categories from our topics
  const categoriesFromTopics = topics.map(t => slugify(t.data.category));
  
  // Manually include categories even if they are empty so the sidebar links don't 404
  const allCategories = ['javascript', 'typescript', 'go', 'nodejs', 'sql', 'system-design'];
  const uniqueCategorySlugs = [...new Set([...categoriesFromTopics, ...allCategories])];
  
  return uniqueCategorySlugs.map(categorySlug => {
    // Map category ID to display name if empty
    const displayNames = {
      'javascript': 'JavaScript',
      'typescript': 'TypeScript',
      'nodejs': 'Node.js',
      'go': 'Go',
      'sql': 'SQL',
      'system-design': 'System Design'
    };
    
    // Filter topics by comparing their slugified category
    const categoryTopics = topics.filter(t => slugify(t.data.category) === categorySlug);
    categoryTopics.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
    
    // Use the actual capitalized category name from the first topic, or fallback
    const categoryName = categoryTopics.length > 0 ? categoryTopics[0].data.category : displayNames[categorySlug];
    
    return {
      params: { category: categorySlug },
      props: { categoryName, topics: categoryTopics }
    };
  });
}

const { categoryName, topics } = Astro.props;
---

<Layout title={`${categoryName} | Engineering Interview Kit`}>
  <div class="space-y-8">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-8 w-max max-w-full overflow-hidden">
      <ol class="flex items-center space-x-1.5 sm:space-x-2 bg-gray-900/60 border border-gray-800/80 px-3 sm:px-4 py-2 rounded-full shadow-inner backdrop-blur-sm text-[11px] sm:text-xs font-medium text-gray-400 overflow-x-auto whitespace-nowrap [&::-webkit-scrollbar]:hidden">
        <li class="flex items-center">
          <a href="/" class="flex items-center hover:text-white transition-colors">
            <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
            Home
          </a>
        </li>
        <li class="flex items-center">
          <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </li>
        <li class="flex items-center" aria-current="page">
          <span class="text-blue-400 bg-blue-500/10 px-2.5 py-0.5 rounded-full border border-blue-500/20 truncate max-w-[150px] sm:max-w-[300px]">{categoryName}</span>
        </li>
      </ol>
    </nav>

    <!-- Hero Header -->
    <header class="relative mb-8 pb-5 border-b border-gray-800/50">
      <!-- Ambient Glow -->
      <div class="absolute top-0 left-1/4 w-64 h-64 bg-blue-500/10 rounded-full blur-[100px] -z-10 pointer-events-none"></div>
      
      <h1 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 mb-4 tracking-tight">
        {categoryName}
      </h1>
      <p class="text-lg md:text-xl text-gray-400 font-medium">
        {topics.length === 0 ? "Content coming soon..." : `${topics.length} highly-curated topics available for revision.`}
      </p>
    </header>

    
    <div class="space-y-10">
      {Object.entries(
        topics.reduce((acc, topic) => {
          const sub = topic.data.subcategory || 'Other Topics';
          if (!acc[sub]) acc[sub] = [];
          acc[sub].push(topic);
          return acc;
        }, {})
      ).map(([subcat, subTopics]) => (
        <section>
          <div class="flex items-center mb-6">
            <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center mr-3 border border-blue-500/20 shadow-inner">
              <span class="text-blue-400 text-lg font-bold">#</span>
            </div>
            <h2 class="text-2xl font-bold text-gray-200 tracking-tight">
              {subcat}
            </h2>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {subTopics.map((topic: any) => (
              <a href={`/topics/${topic.id}`} class="group relative flex flex-col h-full bg-gray-900/40 backdrop-blur-sm border border-gray-800 rounded-xl p-4 hover:border-gray-600 hover:bg-gray-800/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-900/10 overflow-hidden">
                <!-- Subtle Gradient line on top -->
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500/0 via-blue-500/0 to-purple-500/0 group-hover:from-blue-500/50 group-hover:via-indigo-500/50 group-hover:to-purple-500/50 transition-all duration-500"></div>
                
                <div class="flex justify-between items-start mb-2">
                  <h3 class="text-base font-bold text-gray-200 group-hover:text-blue-400 transition-colors pr-2 leading-tight">{topic.data.title}</h3>
                  {topic.data.importance === 'HIGH' && (
                    <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md whitespace-nowrap ml-2 shadow-sm shrink-0">
                      High
                    </span>
                  )}
                  {topic.data.importance === 'MEDIUM' && (
                    <span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md whitespace-nowrap ml-2 shadow-sm shrink-0">
                      Medium
                    </span>
                  )}
                </div>
                
                <p class="text-gray-400 text-[13px] leading-relaxed line-clamp-2 mb-3 flex-1">
                  {topic.data.description}
                </p>
                
                <div class="flex items-center text-[11px] font-medium text-gray-500 mt-auto pt-3 border-t border-gray-800/60 group-hover:border-gray-700 transition-colors">
                  <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span>{topic.data.revisionTime || 5} min read</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
