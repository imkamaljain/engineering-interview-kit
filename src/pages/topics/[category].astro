---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  
  // Helper to normalize category names to URL-friendly slugs
  const slugify = (str) => str.toLowerCase().replace(/\s+/g, '-').replace(/\./g, '');
  
  // Get unique categories from our topics
  const categoriesFromTopics = topics.map(t => slugify(t.data.category));
  
  // Manually include categories even if they are empty so the sidebar links don't 404
  const allCategories = ['javascript', 'typescript', 'go', 'nodejs', 'sql', 'system-design'];
  const uniqueCategorySlugs = [...new Set([...categoriesFromTopics, ...allCategories])];
  
  return uniqueCategorySlugs.map(categorySlug => {
    // Map category ID to display name if empty
    const displayNames = {
      'javascript': 'JavaScript',
      'typescript': 'TypeScript',
      'nodejs': 'Node.js',
      'go': 'Go',
      'sql': 'SQL',
      'system-design': 'System Design'
    };
    
    // Filter topics by comparing their slugified category
    const categoryTopics = topics.filter(t => slugify(t.data.category) === categorySlug);
    
    // Use the actual capitalized category name from the first topic, or fallback
    const categoryName = categoryTopics.length > 0 ? categoryTopics[0].data.category : displayNames[categorySlug];
    
    return {
      params: { category: categorySlug },
      props: { categoryName, topics: categoryTopics }
    };
  });
}

const { categoryName, topics } = Astro.props;
---

<Layout title={`${categoryName} | Engineering Interview Kit`}>
  <div class="space-y-8">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-gray-400 mb-8 flex items-center space-x-2">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-gray-200">{categoryName}</span>
    </nav>

    <header class="mb-10 pb-8 border-b border-gray-800">
      <h1 class="text-4xl font-extrabold text-white mb-4 tracking-tight">{categoryName}</h1>
      <p class="text-xl text-gray-400">
        {topics.length === 0 ? "Content coming soon..." : `${topics.length} topics available for revision.`}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-4">
      {topics.map(topic => (
        <a href={`/topics/${topic.id}`} class="block bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-gray-600 transition-colors group">
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-xl font-bold text-gray-200 group-hover:text-blue-400 transition-colors">{topic.data.title}</h2>
            {topic.data.importance === 'HIGH' && (
              <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 text-xs px-2 py-1 rounded-full whitespace-nowrap ml-4">🔥 High Priority</span>
            )}
          </div>
          <p class="text-gray-400 text-sm leading-relaxed">{topic.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
