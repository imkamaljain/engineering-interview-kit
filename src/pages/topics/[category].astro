---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getCategoryIcon } from "../../utils/icons";
import { SUBCATEGORY_ORDER } from "../../config/subcategories";
import {
  ALL_CATEGORIES,
  CATEGORY_DISPLAY_NAMES,
} from "../../config/categories";

export async function getStaticPaths() {
  const topics = await getCollection("topics");

  // Helper to normalize category names to URL-friendly slugs
  const slugify = (str: string) =>
    str.toLowerCase().replace(/\s+/g, "-").replace(/\./g, "");

  // Get unique categories from our topics
  const categoriesFromTopics = topics.map((t) => slugify(t.data.category));

  // Manually include categories even if they are empty so the sidebar links don't 404
  const uniqueCategorySlugs = [
    ...new Set([...categoriesFromTopics, ...ALL_CATEGORIES]),
  ];

  return uniqueCategorySlugs.map((categorySlug) => {
    // Filter topics by comparing their slugified category
    const categoryTopics = topics.filter(
      (t) => slugify(t.data.category) === categorySlug,
    );
    categoryTopics.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

    // Use the mapped value for the category name, or fallback to the topic's category frontmatter
    const categoryName =
      CATEGORY_DISPLAY_NAMES[categorySlug] ||
      (categoryTopics.length > 0
        ? categoryTopics[0].data.category
        : categorySlug);

    return {
      params: { category: categorySlug },
      props: { categoryName, topics: categoryTopics },
    };
  });
}

const { categoryName, topics } = Astro.props;
const { category } = Astro.params;
const icon = getCategoryIcon(category);
---

<Layout title={`${categoryName} | Engineering Interview Kit`}>
  <div class="space-y-8">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-8 w-max max-w-full overflow-hidden">
      <ol
        class="flex items-center space-x-1.5 sm:space-x-2 bg-gray-900/60 border border-gray-800/80 px-3 sm:px-4 py-2 rounded-full shadow-inner backdrop-blur-sm text-[11px] sm:text-xs font-medium text-gray-400 overflow-x-auto whitespace-nowrap [&::-webkit-scrollbar]:hidden"
      >
        <li class="flex items-center">
          <a
            href="/"
            class="flex items-center hover:text-white transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 mr-1.5"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
              ></path></svg
            >
            Home
          </a>
        </li>
        <li class="flex items-center">
          <svg
            class="w-4 h-4 text-gray-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </li>
        <li class="flex items-center" aria-current="page">
          <span
            class="text-blue-400 bg-blue-500/10 px-2.5 py-0.5 rounded-full border border-blue-500/20 truncate max-w-[150px] sm:max-w-[300px]"
            >{categoryName}</span
          >
        </li>
      </ol>
    </nav>

    <!-- Hero Header -->
    <header class="relative mb-8 pb-5">
      <h1
        class="flex items-center gap-4 text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 mb-4 pb-2 tracking-tight"
      >
        {
          icon && (
            <img
              src={icon}
              alt={`${categoryName} icon`}
              class="w-10 h-10 md:w-12 md:h-12 object-contain"
            />
          )
        }
        {categoryName}
      </h1>
      <p class="text-lg md:text-xl text-gray-400 font-medium mb-6">
        {
          topics.length === 0
            ? "Content coming soon..."
            : `${topics.length} highly-curated topics available for revision.`
        }
      </p>

      <div class="relative group">
        <div
          class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
        >
          <svg
            class="w-5 h-5 text-gray-500 group-focus-within:text-blue-400 transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
          >
        </div>
        <input
          type="text"
          id="search-input"
          class="w-full bg-gray-900/50 border border-gray-700/60 rounded-lg pl-11 pr-12 py-3 text-gray-200 placeholder-gray-500 focus:outline-none focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/50 transition-all shadow-sm"
          placeholder={`Search in ${categoryName}...`}
        />
        <div
          class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none"
        >
          <kbd
            class="hidden sm:inline-block px-2 py-0.5 border border-gray-700 rounded-md text-xs font-mono text-gray-500"
            >/</kbd
          >
        </div>

        <!-- Search Results Dropdown -->
        <div
          id="category-search-results"
          class="absolute top-full left-0 right-0 mt-2 bg-[#161b22] border border-gray-700/60 rounded-lg shadow-xl overflow-hidden z-50 hidden max-h-[400px] overflow-y-auto"
        >
          <!-- Results inserted via JS -->
        </div>
      </div>
    </header>

    <div class="space-y-10">
      {
        Object.entries(
          topics.reduce((acc, topic) => {
            const sub: string = topic.data.subcategory || "Other Topics";
            if (!acc[sub]) acc[sub] = [];
            acc[sub].push(topic);
            return acc;
          }, {}),
        )
          .sort(([a], [b]) => {
            const orderArr = SUBCATEGORY_ORDER[category] || [];
            const aIdx = orderArr.indexOf(a);
            const bIdx = orderArr.indexOf(b);
            return (aIdx === -1 ? 999 : aIdx) - (bIdx === -1 ? 999 : bIdx);
          })
          .map(([subcat, subTopics], i) => (
            <section>
              <div class="flex items-center mb-6">
                <h2 class="text-2xl font-bold text-gray-200 tracking-tight">
                  {i + 1}. {subcat}
                </h2>
                <div class="ml-4 flex-grow h-px bg-gradient-to-r from-gray-800 to-transparent" />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {subTopics.map((topic: any) => (
                  <a
                    href={`/topics/${topic.id}`}
                    class="group relative flex flex-col h-full bg-white/[0.03] backdrop-blur-md border border-white/10 rounded-3xl p-4 hover:border-white/20 hover:bg-white/[0.06] transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-blue-500/10 overflow-hidden"
                  >
                    <div class="flex justify-between items-start mb-2">
                      <h3 class="text-base font-bold text-gray-200 group-hover:text-blue-400 transition-colors pr-2 leading-tight">
                        {topic.data.title}
                      </h3>
                      {topic.data.importance === "HIGH" && (
                        <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md whitespace-nowrap ml-2 shadow-sm shrink-0">
                          High
                        </span>
                      )}
                      {topic.data.importance === "MEDIUM" && (
                        <span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md whitespace-nowrap ml-2 shadow-sm shrink-0">
                          Medium
                        </span>
                      )}
                    </div>

                    <p class="text-gray-400 text-[13px] leading-relaxed line-clamp-2 mb-3 flex-1">
                      {topic.data.description}
                    </p>

                    <div class="flex items-center text-[11px] font-medium text-gray-500 mt-auto pt-3 border-t border-gray-800/60 group-hover:border-gray-700 transition-colors">
                      <svg
                        class="w-3.5 h-3.5 mr-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                      <span>{topic.data.revisionTime || 5} min read</span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))
      }
    </div>
  </div>

  <script
    define:vars={{
      searchData: topics.map((t) => ({
        id: t.id,
        title: t.data.title,
        description: t.data.description,
      })),
    }}
  >
    const searchInput = document.getElementById("search-input");
    const resultsContainer = document.getElementById("category-search-results");

    if (searchInput && resultsContainer) {
      searchInput.addEventListener("input", (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) {
          resultsContainer.classList.add("hidden");
          return;
        }

        const matches = searchData
          .filter(
            (topic) =>
              topic.title.toLowerCase().includes(query) ||
              (topic.description &&
                topic.description.toLowerCase().includes(query)),
          )
          .slice(0, 8);

        if (matches.length > 0) {
          resultsContainer.innerHTML = matches
            .map(
              (m) => `
            <a href="/topics/${m.id}" class="block px-4 py-3 hover:bg-gray-800/50 border-b border-gray-800/50 last:border-0 transition-colors group">
              <div class="text-sm font-medium text-gray-200 group-hover:text-blue-400 transition-colors">${m.title}</div>
              ${m.description ? `<div class="text-[11px] text-gray-500 mt-1 line-clamp-1">${m.description}</div>` : ""}
            </a>
          `,
            )
            .join("");
          resultsContainer.classList.remove("hidden");
        } else {
          resultsContainer.innerHTML = `<div class="px-4 py-4 text-sm text-gray-500 text-center">No topics found for "${e.target.value}"</div>`;
          resultsContainer.classList.remove("hidden");
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener("click", (e) => {
        if (
          !searchInput.contains(e.target) &&
          !resultsContainer.contains(e.target)
        ) {
          resultsContainer.classList.add("hidden");
        }
      });

      // Re-open dropdown on focus if there's text
      searchInput.addEventListener("focus", () => {
        if (searchInput.value.trim()) {
          resultsContainer.classList.remove("hidden");
        }
      });
    }
  </script>
</Layout>
