---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const topics = await getCollection('topics');
const importantTopics = topics.filter(t => t.data.importance === 'HIGH');
---

<Layout title="Most Important Topics | Engineering Interview Kit">
  <div class="space-y-8">
    <header class="mb-10 pb-8 border-b border-gray-800">
      <h1 class="text-4xl font-extrabold text-rose-400 mb-4 tracking-tight flex items-center">
        <span class="mr-3">🔥</span> Most Important Topics
      </h1>
      <p class="text-xl text-gray-400">High priority topics commonly asked in senior engineering interviews.</p>
    </header>

    <div class="grid grid-cols-1 gap-4">
      {importantTopics.map(topic => (
        <a href={`/topics/${topic.id}`} class="block bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-gray-600 transition-colors group">
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-xl font-bold text-gray-200 group-hover:text-rose-400 transition-colors">{topic.data.title}</h2>
            <span class="bg-gray-800 text-gray-300 text-xs px-2 py-1 rounded-full uppercase tracking-wider">{topic.data.category}</span>
          </div>
          <p class="text-gray-400 text-sm">{topic.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
