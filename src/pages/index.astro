---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTopics = await getCollection('topics');

const getCount = (category: string) => allTopics.filter(t => t.data.category === category).length;

const technologies = [
	{
		title: "JavaScript",
		slug: "javascript",
		count: getCount("JavaScript"),
		samples: ["Event loop", "Closures", "Promises", "Prototypal Inheritance"]
	},
	{
		title: "TypeScript",
		slug: "typescript",
		count: getCount("TypeScript"),
		samples: ["Generics", "Utility types", "Type guards", "Declaration merging"]
	},
	{
		title: "Go",
		slug: "go",
		count: getCount("Go"),
		samples: ["Goroutines", "Channels", "Scheduler", "Memory model"]
	},
	{
		title: "Node.js",
		slug: "nodejs",
		count: getCount("Node.js"),
		samples: ["Architecture", "Streams", "Event Loop", "Worker Threads"]
	},
	{
		title: "SQL",
		slug: "sql",
		count: getCount("SQL"),
		samples: ["Joins", "Indexes", "ACID", "Transaction Isolation"]
	},
	{
		title: "Data Structures & Algorithms",
		slug: "dsa",
		count: getCount("DSA"),
		samples: ["Arrays", "Graphs", "Dynamic Programming", "Interview Problems"]
	},
	{
		title: "System Design",
		slug: "system-design",
		count: getCount("System Design"),
		samples: ["Scalability", "Caching", "Databases", "Message Queues"]
	}
];

const priorityTopics = [
	{ name: "JavaScript Event Loop", href: "/topics/javascript/async/event-loop" },
	{ name: "Go Goroutines", href: "/topics/go/concurrency/goroutines" },
	{ name: "SQL Indexes", href: "/topics/sql/indexes/btree-index" },
	{ name: "System Design Caching", href: "/topics/system-design/caching" },
	{ name: "TypeScript Generics", href: "/topics/typescript/types/generics" },
	{ name: "Node.js Architecture", href: "/topics/nodejs/architecture/nodejs-architecture" }
];
---

<Layout title="Engineering Interview Kit">
	<div class="max-w-5xl mx-auto flex flex-col gap-14 pb-12">
		
		<!-- Hero & Global Search -->
		<section class="flex flex-col gap-6 pt-4">
			<div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-6">
				<img src="/logo.svg" alt="Engineering Interview Kit Logo" class="w-16 h-16 sm:w-20 sm:h-20 drop-shadow-lg" />
				<div>
					<h1 class="text-3xl md:text-4xl font-bold text-gray-100 tracking-tight mb-2">Engineering Interview Kit</h1>
					<p class="text-lg text-gray-400">Fast revision for software engineering interviews.</p>
				</div>
			</div>

			<div class="relative group">
				<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
					<svg class="w-5 h-5 text-gray-500 group-focus-within:text-blue-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
				</div>
				<input 
					type="text" 
					id="global-search-input"
					class="w-full bg-[#0d1117] border border-gray-700/60 rounded-lg pl-11 pr-12 py-3 text-gray-200 placeholder-gray-500 focus:outline-none focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/50 transition-all shadow-sm"
					placeholder="Search topics, concepts, patterns..."
				/>
				<div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
					<kbd class="hidden sm:inline-block px-2 py-0.5 border border-gray-700 rounded-md text-xs font-mono text-gray-500">/</kbd>
				</div>
				
				<!-- Search Results Dropdown -->
				<div id="search-results" class="absolute top-full left-0 right-0 mt-2 bg-[#161b22] border border-gray-700/60 rounded-lg shadow-xl overflow-hidden z-50 hidden max-h-[400px] overflow-y-auto">
					<!-- Results inserted via JS -->
				</div>
			</div>
		</section>

		<!-- Browse Topics -->
		<section>
			<h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-5">Browse Topics</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				{technologies.map(tech => (
					<a href={`/topics/${tech.slug}`} class="group flex flex-col bg-[#0d1117] border border-gray-800/60 rounded-xl p-5 hover:border-gray-600/80 hover:bg-[#161b22] transition-all relative overflow-hidden">
						
						<div class="flex justify-between items-start mb-4">
							<h3 class="text-lg font-semibold text-gray-200 group-hover:text-blue-400 transition-colors">{tech.title}</h3>
							<span class="inline-flex items-center justify-center px-2 py-1 rounded-md bg-gray-800/50 text-xs font-medium text-gray-400 group-hover:text-gray-300 border border-gray-700/50">
								{tech.count} topics
							</span>
						</div>
						
						<ul class="text-sm text-gray-500 space-y-1.5 mb-6 flex-grow">
							{tech.samples.map(sample => (
								<li class="flex items-center">
									<span class="w-1 h-1 rounded-full bg-gray-700 mr-2 group-hover:bg-blue-500/50 transition-colors"></span>
									{sample}
								</li>
							))}
						</ul>
						
						<div class="text-sm font-medium text-gray-400 group-hover:text-blue-400 transition-colors flex items-center mt-auto">
							View topics
							<svg class="w-4 h-4 ml-1.5 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- High Priority -->
		<section>
			<h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4 flex items-center">
				<span class="text-red-400 mr-2 text-base">🔥</span> High Priority
			</h2>
			<div class="flex flex-wrap gap-2.5">
				{priorityTopics.map(topic => (
					<a 
						href={topic.href} 
						class="px-3.5 py-1.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-200/90 text-[13px] font-medium hover:bg-red-500/20 hover:border-red-500/30 hover:text-red-100 transition-all"
					>
						{topic.name}
					</a>
				))}
			</div>
		</section>

		<!-- Quick Revision -->
		<section class="border-t border-gray-800/60 pt-10">
			<div class="mb-5">
				<h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider flex items-center mb-1">
					<span class="text-orange-400 mr-2 text-base">⚡</span> Quick Revision
				</h2>
				<p class="text-sm text-gray-500">10-minute revision paths curated for speed.</p>
			</div>
			
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
				{['JavaScript Essentials', 'Go Backend Essentials', 'SQL Interview Essentials', 'System Design Essentials', 'DSA Essentials'].map(path => (
					<a href="/quick-revision" class="px-4 py-3 bg-[#0d1117] border border-gray-800/60 rounded-lg text-sm text-gray-300 hover:text-white hover:border-orange-500/30 hover:bg-[#161b22] transition-all flex items-center justify-between group">
						<span>{path}</span>
						<span class="text-gray-600 group-hover:text-orange-400 transition-colors">→</span>
					</a>
				))}
			</div>
		</section>

	</div>

	<script define:vars={{ searchData: allTopics.map(t => ({ id: t.id, title: t.data.title, category: t.data.category })) }}>
		const globalSearch = document.getElementById('global-search-input');
		const resultsContainer = document.getElementById('search-results');
		
		if (globalSearch && resultsContainer) {
			globalSearch.addEventListener('input', (e) => {
				const query = e.target.value.toLowerCase().trim();
				if (!query) {
					resultsContainer.classList.add('hidden');
					return;
				}
				
				const matches = searchData.filter(topic => 
					topic.title.toLowerCase().includes(query) || 
					topic.category.toLowerCase().includes(query)
				).slice(0, 8); // Max 8 results
				
				if (matches.length > 0) {
					resultsContainer.innerHTML = matches.map(m => `
						<a href="/topics/${m.id}" class="block px-4 py-3 hover:bg-gray-800/50 border-b border-gray-800/50 last:border-0 transition-colors group">
							<div class="text-sm font-medium text-gray-200 group-hover:text-blue-400 transition-colors">${m.title}</div>
							<div class="text-[10px] text-gray-500 uppercase tracking-wider mt-1">${m.category}</div>
						</a>
					`).join('');
					resultsContainer.classList.remove('hidden');
				} else {
					resultsContainer.innerHTML = `<div class="px-4 py-4 text-sm text-gray-500 text-center">No topics found for "${e.target.value}"</div>`;
					resultsContainer.classList.remove('hidden');
				}
			});

			// Close dropdown when clicking outside
			document.addEventListener('click', (e) => {
				if (!globalSearch.contains(e.target) && !resultsContainer.contains(e.target)) {
					resultsContainer.classList.add('hidden');
				}
			});

			// Re-open dropdown on focus if there's text
			globalSearch.addEventListener('focus', () => {
				if (globalSearch.value.trim()) {
					resultsContainer.classList.remove('hidden');
				}
			});
		}
	</script>
</Layout>
