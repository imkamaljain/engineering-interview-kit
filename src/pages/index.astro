---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Engineering Interview Kit">
	<div class="space-y-8">
		<header class="mb-12">
			<h1 class="text-4xl font-extrabold text-white mb-4 tracking-tight">Engineering Interview Kit</h1>
			<p class="text-xl text-gray-400">Fast revision for software engineering interviews.</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<!-- Language Cards -->
			<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-gray-700 transition-colors">
				<h2 class="text-xl font-bold text-white mb-4 flex items-center">
					<span class="mr-2">📝</span> Languages
				</h2>
				<ul class="space-y-3">
					<li>
						<a href="/topics/javascript" class="block group">
							<div class="text-gray-200 group-hover:text-blue-400 font-medium">JavaScript</div>
							<div class="text-sm text-gray-500">Event loop, Closures, Promises...</div>
						</a>
					</li>
					<li>
						<a href="/topics/typescript" class="block group">
							<div class="text-gray-200 group-hover:text-blue-400 font-medium">TypeScript</div>
							<div class="text-sm text-gray-500">Generics, Utility types, Type guards...</div>
						</a>
					</li>
					<li>
						<a href="/topics/go" class="block group">
							<div class="text-gray-200 group-hover:text-blue-400 font-medium">Go</div>
							<div class="text-sm text-gray-500">Goroutines, Channels, Scheduler...</div>
						</a>
					</li>
					<li>
						<a href="/topics/sql" class="block group">
							<div class="text-gray-200 group-hover:text-blue-400 font-medium">SQL</div>
							<div class="text-sm text-gray-500">Joins, Indexes, ACID, MVCC...</div>
						</a>
					</li>
				</ul>
			</div>

			<!-- Architecture & Backend -->
			<div class="space-y-6">
				<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-gray-700 transition-colors">
					<h2 class="text-xl font-bold text-white mb-4 flex items-center">
						<span class="mr-2">⚙️</span> Backend
					</h2>
					<ul class="space-y-3">
						<li>
							<a href="/topics/nodejs" class="block group">
								<div class="text-gray-200 group-hover:text-green-400 font-medium">Node.js</div>
								<div class="text-sm text-gray-500">Architecture, Streams, Performance...</div>
							</a>
						</li>
					</ul>
				</div>

				<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-gray-700 transition-colors">
					<h2 class="text-xl font-bold text-white mb-4 flex items-center">
						<span class="mr-2">🏗️</span> Architecture
					</h2>
					<ul class="space-y-3">
						<li>
							<a href="/topics/system-design" class="block group">
								<div class="text-gray-200 group-hover:text-purple-400 font-medium">System Design</div>
								<div class="text-sm text-gray-500">Scalability, Caching, Databases...</div>
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<!-- Quick Links -->
		<div class="mt-12 flex flex-col sm:flex-row gap-4">
			<a href="/quick-revision" class="flex-1 bg-amber-500/10 border border-amber-500/20 rounded-xl p-6 hover:bg-amber-500/20 transition-colors">
				<h3 class="text-lg font-bold text-amber-400 mb-2">⚡ Quick Revision</h3>
				<p class="text-sm text-gray-400">Condensed 10-minute revision notes for all technologies.</p>
			</a>
			<a href="/important" class="flex-1 bg-rose-500/10 border border-rose-500/20 rounded-xl p-6 hover:bg-rose-500/20 transition-colors">
				<h3 class="text-lg font-bold text-rose-400 mb-2">🔥 Most Important</h3>
				<p class="text-sm text-gray-400">High-priority topics commonly asked in senior interviews.</p>
			</a>
		</div>
	</div>
</Layout>
