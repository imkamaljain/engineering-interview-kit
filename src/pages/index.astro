---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getCategoryIcon } from "../utils/icons";

const allTopics = await getCollection("topics");

import { TECHNOLOGY_GROUPS } from "../config/home-groups";

const slugify = (str: string) =>
	str.toLowerCase().replace(/\s+/g, "-").replace(/\./g, "");
const getCountBySlug = (slug: string) =>
	allTopics.filter((t) => slugify(t.data.category) === slug).length;

const technologyGroups = TECHNOLOGY_GROUPS.map((group) => ({
	...group,
	items: group.items.map((item) => ({
		...item,
		icon: getCategoryIcon(item.slug),
		count: getCountBySlug(item.slug),
	})),
}));
---

<Layout title="Engineering Interview Kit">
	<div class="max-w-5xl mx-auto flex flex-col gap-14 pb-12">
		<!-- Hero & Global Search -->
		<section class="flex flex-col gap-6 pt-4">
			<div
				class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-6"
			>
				<img
					src="/logo.svg"
					alt="Engineering Interview Kit Logo"
					class="w-16 h-16 sm:w-20 sm:h-20 drop-shadow-lg"
				/>
				<div>
					<h1
						class="text-3xl md:text-4xl font-bold text-gray-100 tracking-tight pb-1 mb-2"
					>
						Engineering Interview Kit
					</h1>
					<p class="text-lg text-gray-400">
						Fast revision for software engineering interviews.
					</p>
				</div>
			</div>

			<div class="relative group">
				<div
					class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
				>
					<svg
						class="w-5 h-5 text-gray-500 group-focus-within:text-blue-400 transition-colors"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						><path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
						></path></svg
					>
				</div>
				<input
					type="text"
					id="global-search-input"
					class="w-full bg-[#0d1117] border border-gray-700/60 rounded-lg pl-11 pr-12 py-3 text-gray-200 placeholder-gray-500 focus:outline-none focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/50 transition-all shadow-sm"
					placeholder="Search topics, concepts, patterns..."
				/>
				<div
					class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none"
				>
					<kbd
						class="hidden sm:inline-block px-2 py-0.5 border border-gray-700 rounded-md text-xs font-mono text-gray-500"
						>/</kbd
					>
				</div>

				<!-- Search Results Dropdown -->
				<div
					id="search-results"
					class="absolute top-full left-0 right-0 mt-2 bg-[#161b22] border border-gray-700/60 rounded-lg shadow-xl overflow-hidden z-50 hidden max-h-[400px] overflow-y-auto"
				>
					<!-- Results inserted via JS -->
				</div>
			</div>
		</section>

		<!-- Browse Topics -->
		<section>
			<div class="space-y-10">
				{
					technologyGroups.map((group) => (
						<div>
							<div class="flex items-center mb-6">
								<h3 class="text-sm font-bold text-transparent bg-clip-text bg-gradient-to-r from-gray-300 to-gray-500 uppercase pb-1 tracking-[0.2em]">
									{group.groupName}
								</h3>
								<div class="ml-4 flex-grow h-px bg-gradient-to-r from-gray-800 to-transparent" />
							</div>
							<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
								{group.items.map((tech) => (
									<a
										href={`/topics/${tech.slug}`}
										class="group flex flex-col bg-white/[0.03] backdrop-blur-md border border-white/10 rounded-3xl p-5 hover:border-white/20 hover:bg-white/[0.06] transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-blue-500/10 relative overflow-hidden"
									>
										<div class="flex justify-between items-start mb-4">
											<div class="flex items-center gap-3">
												{tech.icon && (
													<img
														src={tech.icon}
														alt={`${tech.title} icon`}
														class="w-7 h-7 object-contain drop-shadow-sm group-hover:scale-110 transition-transform duration-300"
													/>
												)}
												<h3 class="text-lg font-semibold text-gray-200 group-hover:text-blue-400 transition-colors">
													{tech.title}
												</h3>
											</div>
										</div>

										<ul class="text-sm text-gray-500 space-y-1.5 mb-6 flex-grow">
											{tech.samples.map((sample) => (
												<li class="flex items-center">
													<span class="w-1 h-1 rounded-full bg-gray-700 mr-2 group-hover:bg-blue-500/50 transition-colors" />
													{sample}
												</li>
											))}
										</ul>

										<div class="text-sm font-medium text-gray-400 group-hover:text-blue-400 transition-colors flex items-center mt-auto border-t border-gray-800/60 pt-3">
											View {tech.count} topics
											<svg
												class="w-4 h-4 ml-1.5 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M14 5l7 7m0 0l-7 7m7-7H3"
												/>
											</svg>
										</div>
									</a>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
	</div>

	<script
		define:vars={{
			searchData: allTopics.map((t) => ({
				id: t.id,
				title: t.data.title,
				category: t.data.category,
				icon: getCategoryIcon(t.data.category),
			})),
		}}
	>
		const globalSearch = document.getElementById("global-search-input");
		const resultsContainer = document.getElementById("search-results");

		if (globalSearch && resultsContainer) {
			globalSearch.addEventListener("input", (e) => {
				const query = e.target.value.toLowerCase().trim();
				if (!query) {
					resultsContainer.classList.add("hidden");
					return;
				}

				const matches = searchData
					.filter(
						(topic) =>
							topic.title.toLowerCase().includes(query) ||
							topic.category.toLowerCase().includes(query),
					)
					.slice(0, 8); // Max 8 results

				if (matches.length > 0) {
					resultsContainer.innerHTML = matches
						.map(
							(m) => `
						<a href="/topics/${m.id}" class="block px-4 py-3 hover:bg-gray-800/50 border-b border-gray-800/50 last:border-0 transition-colors group">
							<div class="flex items-center gap-2">
								${m.icon ? `<img src="${m.icon}" class="w-4 h-4 object-contain" alt=""/>` : ""}
								<div class="text-sm font-medium text-gray-200 group-hover:text-blue-400 transition-colors">${m.title}</div>
							</div>
							<div class="text-[10px] text-gray-500 uppercase tracking-wider mt-1 ${m.icon ? "ml-6" : ""}">${m.category}</div>
						</a>
					`,
						)
						.join("");
					resultsContainer.classList.remove("hidden");
				} else {
					resultsContainer.innerHTML = `<div class="px-4 py-4 text-sm text-gray-500 text-center">No topics found for "${e.target.value}"</div>`;
					resultsContainer.classList.remove("hidden");
				}
			});

			// Close dropdown when clicking outside
			document.addEventListener("click", (e) => {
				if (
					!globalSearch.contains(e.target) &&
					!resultsContainer.contains(e.target)
				) {
					resultsContainer.classList.add("hidden");
				}
			});

			// Re-open dropdown on focus if there's text
			globalSearch.addEventListener("focus", () => {
				if (globalSearch.value.trim()) {
					resultsContainer.classList.remove("hidden");
				}
			});
		}
	</script>
</Layout>
